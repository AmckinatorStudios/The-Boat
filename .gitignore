# Клон движка, если tools/run.sh скачал его сам
.engine/
# Собранная игра
dist/
*.log

# Сайдкары ассетов (*.meta) НЕ игнорируются намеренно — они несут GUID, то
# есть личность файла. Если их не коммитить, на каждой машине сгенерируются
# свои номера, и ссылки в сценах разойдутся ровно там, где должны были
# держаться. Это единственный файл в проекте, который обязан быть в git,
# даже если выглядит служебным.
